# Copy the idea, not this file. The real file is $BRIDGE_DATA_DIR/webhook.env
# and it must be mode 0600. Do not commit it and do not point it at an app
# settings file. Leave the switches at 0 until login has been checked.
WECHAT_WEBHOOK_URL=
WECHAT_WEBHOOK_KEY=
WECHAT_FORWARD_ENABLED=0
WECHAT_SEND_ENABLED=0
